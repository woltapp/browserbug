{
  "name": "@woltapp/browserbug-root",
  "version": "0.0.0",
  "private": true,
  "description": "Document, and eventually remove, browser bug workarounds",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin"
  ],
  "license": "MIT",
  "author": "Wolt Enterprises Oy",
  "repository": {
    "type": "git",
    "url": "https://github.com/woltapp/browserbug.git"
  },
  "scripts": {
    "bench": "pnpm --recursive --if-present run bench",
    "build": "pnpm --recursive run build",
    "changeset:release": "pnpm build && changeset git-tag && pnpm --recursive publish",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "check-types": "pnpm --recursive run check-types",
    "lint": "pnpm --recursive lint",
    "prepare": "husky",
    "release": "pnpm --recursive publish",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@changesets/cli": "^3.0.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@tsconfig/node22": "22.0.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.78.0",
    "publint": "0.3.25",
    "rimraf": "6.1.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "eslint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  }
}
