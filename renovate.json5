{
  // NOTE: VS Code does not support json5. You should change the file
  // association to jsonc:
  // Cmd+Shift+P -> "Configure file association for .json5" -> "JSON with Comments"
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    // All packages in this monorepo are published libraries: pin
    // devDependencies, and keep ranges for dependencies/peerDependencies.
    "config:best-practices",
    "config:js-lib",
    "schedule:weekly"
  ],
  "timezone": "Europe/Helsinki",
  "lockFileMaintenance": {
    "enabled": true,
    "postUpdateOptions": ["pnpmDedupe"]
  },
  "packageRules": [
    {
      // Matches minimumReleaseAge in pnpm-workspace.yaml (7 days). Without
      // this, Renovate would open PRs for releases that pnpm then refuses to
      // install.
      "description": "Match the pnpm minimumReleaseAge in pnpm-workspace.yaml",
      "matchManagers": ["npm"],
      // Mirrors minimumReleaseAgeExclude in pnpm-workspace.yaml: first-party
      // packages can be installed immediately.
      "matchPackageNames": ["!@woltapp/*"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group semver-compatible updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": ">=1.0.0",
      "groupName": "non-major dependencies"
    }
  ]
}
