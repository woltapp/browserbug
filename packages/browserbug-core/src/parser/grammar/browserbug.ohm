Browserbug {
  Exp
    = opener ListOf<DescriptorExp, ","> CommentExp?

  DescriptorExp
    = WebFeatureExp
    | BrowserAndVersionExp

  // A feature from the web-features dataset (https://github.com/web-platform-dx/web-features),
  // e.g. `web-feature scroll-driven-animations`. Its support versions come
  // from the dataset, instead of being written out per browser.
  WebFeatureExp
    = webfeature featureId

  BrowserAndVersionExp
    = ident CompExp

  CompExp
    = SingleComparatorExp
    | MultiComparatorExp

  SingleComparatorExp
    = singlecomparator Version

  MultiComparatorExp
    = multicomparator Version Version

  Version
    = number "." number  -- majorminor
    | number            -- major

  CommentExp
    = commentstart commentChars?

  commentChars
    = ~end any+

  ident (an identifier)
    = ~reserved identifierPart+

  identifierPart
    = alnum
    | "_"
    | "-"

  // web-features ids are lowercase kebab-case
  featureId (a web-features feature id)
    = (lower | digit | "-")+

  number (a number)
    = digit+

  opener = "@browserbug"
  singlecomparator = "lte" | "lt" | "lower-than-or-equal" | "lower-than" | "equal" | "last-checked"
  multicomparator = "between"
  webfeature = "web-feature"
  commentstart = "--"
  reserved = opener | singlecomparator | multicomparator | webfeature | commentstart
}