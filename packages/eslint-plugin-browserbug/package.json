{
  "name": "@woltapp/eslint-plugin-browserbug",
  "version": "1.0.0",
  "description": "Document, and eventually remove, browser bug workarounds",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin"
  ],
  "license": "MIT",
  "author": "Wolt Enterprises Oy",
  "repository": {
    "type": "git",
    "url": "https://github.com/woltapp/browserbug.git",
    "directory": "packages/eslint-plugin-browserbug"
  },
  "files": [
    "dist",
    "docs",
    "skills"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm-run-all build:clean build:lib",
    "build:clean": "rimraf dist/",
    "build:lib": "tsc --project tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "check-types:watch": "tsc --noEmit --watch",
    "copy-skills": "node -e \"const fs = require('node:fs'); fs.rmSync('skills', { recursive: true, force: true }); fs.cpSync('../../skills', 'skills', { recursive: true })\"",
    "eslint-docs": "eslint-doc-generator",
    "lint": "npm-run-all \"lint:*\"",
    "lint:docs": "eslint-doc-generator --check",
    "lint:format": "oxfmt --check .",
    "lint:scripts": "eslint lib",
    "prepack": "pnpm copy-skills",
    "publint": "publint",
    "prepublishOnly": "pnpm build && publint && attw --pack --profile esm-only --no-summary",
    "test": "vitest"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.93.0",
    "@woltapp/oxlint-plugin-browserbug": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@typescript-eslint/rule-tester": "8.72.1",
    "@typescript-eslint/utils": "8.72.1",
    "eslint": "10.14.0",
    "eslint-doc-generator": "3.7.1",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "eslint9": "npm:eslint@9.39.5",
    "web-features": "3.45.0"
  },
  "peerDependencies": {
    "browserslist": "^4.22.2",
    "eslint": "^9 || ^10",
    "web-features": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
