{
  "name": "@woltapp/oxlint-plugin-browserbug",
  "version": "1.0.0",
  "description": "Document, and eventually remove, browser bug workarounds",
  "keywords": [
    "browserbug",
    "oxlint",
    "oxlint-plugin"
  ],
  "license": "MIT",
  "author": "Wolt Enterprises Oy",
  "repository": {
    "type": "git",
    "url": "https://github.com/woltapp/browserbug.git",
    "directory": "packages/oxlint-plugin-browserbug"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm-run-all build:clean build:lib",
    "build:clean": "rimraf dist/",
    "build:lib": "tsc --project tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "check-types:watch": "tsc --noEmit --watch",
    "copy-skills": "node -e \"const fs = require('node:fs'); fs.rmSync('skills', { recursive: true, force: true }); fs.cpSync('../../skills', 'skills', { recursive: true })\"",
    "lint": "npm-run-all \"lint:*\"",
    "lint:format": "oxfmt --check .",
    "lint:scripts": "eslint src tests",
    "prepack": "pnpm copy-skills",
    "publint": "publint",
    "prepublishOnly": "pnpm build && publint && attw --pack --profile esm-only --no-summary",
    "test": "vitest"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.93.0",
    "@woltapp/browserbug-core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "oxlint": "1.93.0",
    "web-features": "3.45.0"
  },
  "peerDependencies": {
    "browserslist": "^4.22.2",
    "oxlint": "^1.93.0",
    "web-features": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
